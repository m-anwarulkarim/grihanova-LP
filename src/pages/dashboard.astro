---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard - Griha Nova">
  <div class="max-w-6xl mx-auto p-8">
    <header class="mb-10 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Dashboard</h1>
        <p class="text-slate-500 mt-1">Manage your landing pages and global tracking</p>
      </div>
    </header>

    <!-- Global Tracking Setup -->
    <section class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <div class="mb-6 flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-100 text-indigo-600 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-slate-800">Global Tracking APIs</h2>
          <p class="text-sm text-slate-500">Configure Facebook Pixel and Conversion API (Applies to all landing pages)</p>
        </div>
      </div>

      <form id="trackingForm" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Facebook Pixel ID</label>
          <input type="text" id="pixelId" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" placeholder="e.g. 123456789012345">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Conversion API Access Token</label>
          <input type="text" id="capiToken" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" placeholder="EAAB...">
        </div>
        <div class="md:col-span-2">
          <button type="button" onclick="saveTracking()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
            Save Configuration
          </button>
          <p id="saveMsg" class="mt-3 text-sm text-emerald-600 hidden font-medium">Settings saved successfully!</p>
        </div>
      </form>
    </section>

    <!-- Landing Pages -->
    <h2 class="text-xl font-bold text-slate-800 mb-6">Active Landing Pages</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/" class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-pink-300 transition-all">
        <div class="w-12 h-12 bg-pink-100 text-pink-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        </div>
        <div class="flex justify-between items-start">
          <h2 class="text-lg font-bold text-slate-800 mb-2">Magic Foam (Main Page)</h2>
          <span class="bg-pink-100 text-pink-700 text-xs px-2 py-1 rounded font-bold">HOMEPAGE</span>
        </div>
        <p class="text-slate-500 text-sm">Active campaign. Click to preview the live landing page.</p>
      </a>

      <a href="/lp/tap-filter" class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-blue-300 transition-all">
        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <h2 class="text-lg font-bold text-slate-800 mb-2">Tap Filter Landing Page</h2>
        <p class="text-slate-500 text-sm">Active campaign. Click to preview the live landing page.</p>
      </a>
      
      <a href="/lp/pain-patch" class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-emerald-300 transition-all">
        <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        </div>
        <h2 class="text-lg font-bold text-slate-800 mb-2">Pain Relief Patch</h2>
        <p class="text-slate-500 text-sm">Active campaign. Click to preview the live landing page.</p>
      </a>

    </div>
  </div>

  <script is:inline>
    // Load existing settings
    document.addEventListener('DOMContentLoaded', () => {
      const savedPixel = localStorage.getItem('fb_pixel_id');
      const savedCapi = localStorage.getItem('fb_capi_token');
      if (savedPixel) document.getElementById('pixelId').value = savedPixel;
      if (savedCapi) document.getElementById('capiToken').value = savedCapi;
    });

    function saveTracking() {
      const pixelId = document.getElementById('pixelId').value;
      const capiToken = document.getElementById('capiToken').value;
      
      localStorage.setItem('fb_pixel_id', pixelId);
      localStorage.setItem('fb_capi_token', capiToken);
      
      const msg = document.getElementById('saveMsg');
      msg.classList.remove('hidden');
      setTimeout(() => {
        msg.classList.add('hidden');
      }, 3000);
    }
  </script>
</Layout>
