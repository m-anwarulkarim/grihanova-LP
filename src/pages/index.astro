---
import '../styles/global.css';
import '../styles/home.css';
import Tracking from '../components/Tracking.astro';
---

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magic Foam Sponge - Griha Nova</title>
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <Tracking />
    <link rel="shortcut icon" href="/favicon.jpg" />
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    

  <!-- Top Announcement Bar (Exact demo_honey Style matching Screenshot 1) -->
  <div class="announcement-bar-honey">
    <div class="wrap bar-wrap-honey">
      <span class="badge-offer-honey">
        <i class="fa-solid fa-bolt"></i>
        <span>বিশেষ অফার</span>
      </span>
      <span class="ann-text-honey">
        🔥 আজই অর্ডারে পাচ্ছেন <b class="gold-bold">ফ্রি হোম ডেলিভারি ও বিশেষ ছাড়!</b>
      </span>
      <a href="tel:01790081623" class="phone-pill-honey">
        <i class="fa-solid fa-phone"></i>
        <span>01790-081623</span>
      </a>
    </div>
  </div>

  <!-- Sticky Navbar (Exact demo_honey White Navbar matching Screenshots 1 & 2) -->
  <header class="navbar-honey" id="navbar">
    <div class="wrap nav-wrap-honey">
      
      <!-- Brand Logo -->
      <a href="#" class="brand-logo-honey" style="display: flex; align-items: center;">
        <img src="/logo.jpg" alt="Griha Nova" style="height: 55px; width: auto; object-fit: contain; mix-blend-mode: multiply; transform: scale(1.3); transform-origin: left center;" />
      </a>

      <!-- Desktop Nav Links -->
      <nav class="nav-links-honey" id="navLinks">
        <a href="#hero" class="nav-link-item active">হোম</a>
        <a href="#features" class="nav-link-item">উপকারিতা</a>
        <a href="#gallery" class="nav-link-item">গ্যালারি</a>
        <a href="#reviews" class="nav-link-item">রিভিউ</a>
        <a href="#faq" class="nav-link-item">প্রশ্নোত্তর</a>
      </nav>

      <!-- Right Action Button -->
      <div class="nav-actions-honey">
        <a href="#orderSection" class="btn-order-honey">
          অর্ডার করুন
        </a>
      </div>

    </div>
  </header>

  <!-- Hero Section (demo_clothing 2-Column Grid Layout) -->
  <section class="hero-section" id="hero">
    <div class="wrap hero-grid">
      
      <!-- Hero Left Info Content -->
      <div class="hero-content fade-in">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>যে কোনো জেদি দাগ পরিষ্কারের সেরা সমাধান</span>
        </div>

        <h1 class="hero-title">
          <span class="gold-gradient">Premium Magic Foam</span> - শুধু পানিতেই দাগ গায়েব!
        </h1>

        <p class="hero-sub">
          বাড়ির যেকোনো জেদি দাগ তুলতে আর ঘাম ঝরানোর দিন শেষ! Premium Magic Foam শুধু পানিতে ভিজিয়ে আলতো করে ঘষলেই দেয়ালের দাগ, রান্নাঘরের চিটচিটে ময়লা, পুরোনো জুতা কিংবা বাথরুমের টাইলস—সবকিছু মুহূর্তেই হয়ে যাবে নতুনের মতো ঝকঝকে। কোনো ক্ষতিকর কেমিক্যালের প্রয়োজন নেই!
        </p>

        <!-- Rating Box -->
        <div class="rating-box">
          <div class="stars">★★★★★</div>
          <span><b>৪.৯/৫</b> (২,৪০০+ ভেরিফাইড রিভিউ)</span>
        </div>

        <!-- Price Display -->
        <div class="hero-price">
          <span class="curr-price">৳৪৫০</span>
          <span class="old-price">৳৬০০</span>
          <span class="save-badge">৳১৫০ (২৫% ছাড়)</span>
        </div>

        <!-- Feature Bullets -->
        <ul class="hero-features hide-on-mobile">
          <li>✨ <b>১০০% কেমিক্যাল-ফ্রি:</b> কোনো সাবান বা ডিটারজেন্ট ছাড়াই শুধুমাত্র পানির সাহায্যে জেদি দাগ দূর করে।</li>
          <li>✨ <b>মাল্টি-পারপাস ক্লিনিং:</b> দেয়ালের কালির দাগ, চামড়ার জুতা, কিবোর্ড, সিংক ও টাইলস পরিষ্কারে অনবদ্য।</li>
          <li>✨ <b>ইকো-ফ্রেন্ডলি মেটেরিয়াল:</b> উচ্চ ঘনত্বের (High-Density) মেলামাইন ফোম, যা হাত ও পরিবেশের জন্য সম্পূর্ণ নিরাপদ।</li>
          <li>✨ <b>কাস্টমাইজ সাইজ:</b> আপনার প্রয়োজন অনুযায়ী কাঁচি দিয়ে ছোট-বড় যেকোনো সাইজে কেটে ব্যবহার করতে পারবেন।</li>
        </ul>

        <div class="hero-cta-group">
          <a href="#orderSection" class="btn btn-hero btn-pulse">
            <i class="fa-solid fa-cart-shopping"></i>
            <span>সরাসরি অর্ডার করুন 🛍️</span>
          </a>
          <a href="https://wa.me/8801602867954?text=হ্যালো%20Griha%20Nova,%20আমি%20ম্যাজিক%20ফোম%20স্পঞ্জ%20সম্পর্কে%20জানতে%20চাই" target="_blank" rel="noopener" class="btn btn-wa-hero">
            <i class="fa-brands fa-whatsapp"></i>
            <span>WhatsApp-এ কথা বলুন</span>
          </a>
        </div>
      </div>

      <!-- Hero Gallery (Placed on Right on Desktop, Top on Mobile/Stacked order:-1) -->
      <div class="hero-gallery fade-in">
        <div class="main-img-box">
          <span class="stock-badge">স্টক সীমিত! ⚡</span>
          <img id="main-view" src="/lp/magic-foam/images/hero-new.png" alt="Magic Foam">
          <div class="active-color-name" id="color-label">১০ পিস প্যাক</div>
        </div>

        <!-- Thumbnails Selector -->
        <div class="thumb-selector">
          <button class="thumb-btn active" data-img="/lp/magic-foam/images/hero-new.png" data-name="১০ পিস প্যাক" data-price="450">
            <img src="/lp/magic-foam/images/hero-new.png" alt="10pcs">
            <span>১০ পিস প্যাক</span>
          </button>
          <button class="thumb-btn" data-img="/lp/magic-foam/images/foam-20pcs-new.jpg" data-name="২০ পিস প্যাক" data-price="720">
            <img src="/lp/magic-foam/images/foam-20pcs-new.jpg" alt="20pcs">
            <span>২০ পিস প্যাক</span>
          </button>
          <button class="thumb-btn" data-img="/lp/magic-foam/images/foam-30pcs-new.jpg" data-name="৩০ পিস প্যাক" data-price="950">
            <img src="/lp/magic-foam/images/foam-30pcs-new.jpg" alt="30pcs">
            <span>৩০ পিস প্যাক</span>
          </button>
          <button class="thumb-btn" data-img="/lp/magic-foam/images/foam-50pcs-new.jpg" data-name="৫০ পিস প্যাক" data-price="1350">
            <img src="/lp/magic-foam/images/foam-50pcs-new.jpg" alt="50pcs">
            <span>৫০ পিস প্যাক</span>
          </button>
          <button class="thumb-btn" data-img="/lp/magic-foam/images/foam-100pcs-new.jpg" data-name="১০০ পিস প্যাক" data-price="1950">
            <img src="/lp/magic-foam/images/foam-100pcs-new.jpg" alt="100pcs">
            <span>১০০ পিস প্যাক</span>
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- Features Cards Section -->
  <section class="section features-section" id="features">
    <div class="wrap">
      <div class="sec-header fade-in">
        <span class="sub-badge">কেন এটি সবার পছন্দ?</span>
        <h2>ম্যাজিক স্পঞ্জ-এর অবিশ্বাস্য গুণাবলি</h2>
      </div>

      <div class="features-grid">
        <div class="feat-card glass-card fade-in">
          <div class="card-num">01</div>
          <div class="feat-icon-box">
            <i class="fa-solid fa-gem"></i>
          </div>
          <div class="feat-content">
            <h3>শুধুমাত্র পানি দিয়ে দাগ দূর</h3>
            <p>কোনো প্রকার সাবান বা ক্ষতিকর কেমিক্যাল ছাড়াই শুধু পানিতে ভিজিয়ে দাগ ও ময়লা পরিষ্কার করার জাদুকরী ক্ষমতা।</p>
          </div>
        </div>

        <div class="feat-card glass-card fade-in">
          <div class="card-num">02</div>
          <div class="feat-icon-box">
            <i class="fa-solid fa-shield-virus"></i>
          </div>
          <div class="feat-content">
            <h3>১০০% নিরাপদ ও পরিবেশবান্ধব</h3>
            <p>ত্বকের জন্য ক্ষতিকর এমন কোনো উপাদান এতে নেই। সম্পূর্ণ ইকো-ফ্রেন্ডলি মেলামাইন ফোম দিয়ে তৈরি।</p>
          </div>
        </div>

        <div class="feat-card glass-card fade-in">
          <div class="card-num">03</div>
          <div class="feat-icon-box">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </div>
          <div class="feat-content">
            <h3>মাল্টি-পারপাস ক্লিনিং সমাধান</h3>
            <p>দেয়াল, সুইচবোর্ড, জুতা, টাইলস, সিংক, সোফা, গাড়ির সিট থেকে শুরু করে বাথরুমের জেদি দাগ—সব পরিষ্কার করে অনায়াসে।</p>
          </div>
        </div>

        <div class="feat-card glass-card fade-in">
          <div class="card-num">04</div>
          <div class="feat-icon-box">
            <i class="fa-solid fa-scissors"></i>
          </div>
          <div class="feat-content">
            <h3>কাস্টমাইজ করে ব্যবহারের সুবিধা</h3>
            <p>যেকোনো ছোট বা সরু জায়গায় ব্যবহারের জন্য কাঁচি দিয়ে আপনার প্রয়োজন মতো সাইজে কেটে নেওয়া যায়।</p>
          </div>
        </div>

        <!-- <div class="feat-card glass-card fade-in">
          <div class="card-num">05</div>
          <div class="feat-icon-box">
            <i class="fa-solid fa-truck-fast"></i>
          </div>
          <div class="feat-content">
            <h3>দেখে পেমেন্টের নিশ্চয়তা</h3>
            <p>ক্যাশ অন ডেলিভারিতে পার্সেল খুলে প্রোডাক্ট দেখে নিশ্চিন্তে টাকা পরিশোধের সুবিধা।</p>
          </div>
        </div> -->
      </div>
    </div>
  </section>

  <!-- Product Showcase Section -->
  <section class="section color-showcase-section" id="gallery">
    <div class="wrap">
      <div class="sec-header fade-in">
        <span class="sub-badge">প্রিমিয়াম বিউটি কালেকশন</span>
        <h2>আপনার প্রয়োজন অনুযায়ী প্যাকেজ বেছে নিন</h2>
      </div>

      <div class="color-grid">
        <div class="color-card glass-card fade-in">
          <div class="color-img-wrapper">
            <span class="card-badge">স্টার্টার প্যাক</span>
            <img src="/lp/magic-foam/images/hero-new.png" alt="10 Pcs">
          </div>
          <div class="color-details">
            <h3>১০ পিস প্যাক</h3>
            <p class="card-desc">প্রতিদিনের টুকিটাকি দাগ পরিষ্কারের জন্য।</p>
            <div class="card-price-row">
              <span class="c-price">৳৪৫০</span>
              <span class="c-old">৳৬০০</span>
            </div>
            <a href="#orderSection" onclick="selectVariant('১০ পিস প্যাক', '450')" class="btn btn-outline-gold">অর্ডার সিলেক্ট করুন</a>
          </div>
        </div>

        <div class="color-card glass-card fade-in">
          <div class="color-img-wrapper">
            <span class="card-badge">সেরা বিক্রেতা 🌟</span>
            <img src="/lp/magic-foam/images/foam-20pcs-new.jpg" alt="20 Pcs">
          </div>
          <div class="color-details">
            <h3>২০ পিস প্যাক</h3>
            <p class="card-desc">পরিবারের প্রতিদিনের পরিচ্ছন্নতার জন্য দারুণ একটি প্যাকেজ।</p>
            <div class="card-price-row">
              <span class="c-price">৳৭২০</span>
              <span class="c-old">৳৯০০</span>
            </div>
            <a href="#orderSection" onclick="selectVariant('২০ পিস প্যাক', '720')" class="btn btn-outline-gold">অর্ডার সিলেক্ট করুন</a>
          </div>
        </div>

        <div class="color-card glass-card fade-in">
          <div class="color-img-wrapper">
            <span class="card-badge">ভ্যালু প্যাক</span>
            <img src="/lp/magic-foam/images/foam-30pcs-new.jpg" alt="30 Pcs">
          </div>
          <div class="color-details">
            <h3>৩০ পিস প্যাক</h3>
            <p class="card-desc">সাশ্রয়ী মূল্যে মাঝারি ব্যবহারের জন্য সেরা প্যাকেজ।</p>
            <div class="card-price-row">
              <span class="c-price">৳৯৫০</span>
              <span class="c-old">৳১২০০</span>
            </div>
            <a href="#orderSection" onclick="selectVariant('৩০ পিস প্যাক', '950')" class="btn btn-outline-gold">অর্ডার সিলেক্ট করুন</a>
          </div>
        </div>

        <div class="color-card glass-card fade-in combo-highlight">
          <div class="color-img-wrapper">
            <span class="card-badge gold-badge">সবচেয়ে জনপ্রিয় 🔥</span>
            <img src="/lp/magic-foam/images/foam-50pcs-new.jpg" alt="50 Pcs">
          </div>
          <div class="color-details">
            <h3>৫০ পিস প্যাক</h3>
            <p class="card-desc">এক মাসের জন্য নিশ্চিন্ত পরিষ্কার পরিচ্ছন্নতার বেস্ট ডিল।</p>
            <div class="card-price-row">
              <span class="c-price gold-price">৳১৩৫০</span>
              <span class="c-old">৳১৮০০</span>
            </div>
            <a href="#orderSection" onclick="selectVariant('৫০ পিস প্যাক', '1350')" class="btn btn-primary btn-hero-sm">অর্ডার সিলেক্ট করুন</a>
          </div>
        </div>

        <div class="color-card glass-card fade-in">
          <div class="color-img-wrapper">
            <span class="card-badge">সুপার সেভার 🎁</span>
            <img src="/lp/magic-foam/images/foam-100pcs-new.jpg" alt="100 Pcs">
          </div>
          <div class="color-details">
            <h3>১০০ পিস প্যাক</h3>
            <p class="card-desc">বেশি স্পঞ্জ, বেশি সাশ্রয়! সারা বাড়ির পরিচ্ছন্নতায় নিশ্চিন্ত সমাধান।</p>
            <div class="card-price-row">
              <span class="c-price">৳১৯৫০</span>
              <span class="c-old">৳২৫০০</span>
            </div>
            <a href="#orderSection" onclick="selectVariant('১০০ পিস প্যাক', '1950')" class="btn btn-outline-gold">অর্ডার সিলেক্ট করুন</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clean Order Form Section (Exact Horizontal Package Grid from Screenshot) -->
  <section class="section order-section" id="orderSection">
    <div class="wrap">
      <div class="order-container fade-in">
        <div class="order-header">
          <span class="order-badge">⚡ ক্যাশ অন ডেলিভারি</span>
          <h2>অর্ডার করতে নিচের ফর্মটি পূরণ করুন</h2>
        </div>

        <form id="checkout-form" class="checkout-form">
          <div class="form-grid">
            
            <!-- Left Block: Package Selection (Exact Horizontal Cards matching Screenshot) -->
            <div class="form-block product-spec">
              <div class="step-title">
                <span class="step-badge">১</span>
                <h3>প্যাকেজ নির্বাচন করুন</h3>
              </div>

              <!-- Live Selected Package Banner -->
              <div class="selected-package-notify" id="selected-package-notify">
                <i class="fa-solid fa-circle-check"></i>
                <span>নির্বাচিত প্যাকেজ: <strong id="selected-pkg-name">Premium Magic Foam - ৩০ পিস</strong> (মূল্য: ৳<strong id="selected-pkg-price">১৬৫০</strong>)</span>
              </div>

              <!-- 3 Horizontal Package Cards matching Screenshot -->
              <div class="package-horizontal-grid">
                <label class="package-card-pill active">
                  <input type="radio" name="selected_variant" value="১০ পিস প্যাক" data-price="450" checked>
                  <div class="pill-top">
                    <span class="custom-radio"></span>
                    <span class="tag-badge badge-rose">স্টার্টার</span>
                  </div>
                  <div class="pill-body">
                    <div class="pkg-title">১০ পিস প্যাক</div>
                    <div class="pkg-price">৳৪৫০</div>
                  </div>
                  <div class="pill-foot">
                    <span class="discount-pill">৳১৫০ ছাড়</span>
                  </div>
                </label>

                <label class="package-card-pill">
                  <input type="radio" name="selected_variant" value="২০ পিস প্যাক" data-price="720">
                  <div class="pill-top">
