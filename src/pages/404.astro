---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - পেজ পাওয়া যায়নি | Griha Nova">
  <div class="min-h-screen bg-gradient-to-b from-[#fffdfa] via-sky-50 to-white text-slate-800 font-sans flex items-center justify-center p-4 relative overflow-hidden">
    
    <!-- Animated background elements -->
    <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-sky-300/20 rounded-full blur-[100px] animate-pulse"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[400px] h-[400px] bg-amber-200/20 rounded-full blur-[80px] animate-pulse" style="animation-delay: 1.5s;"></div>
    
    <div class="relative z-10 max-w-lg w-full bg-white/80 backdrop-blur-xl rounded-3xl shadow-[0_10px_40px_rgba(14,165,233,0.1)] p-10 md:p-14 text-center border border-sky-100">
      
      <!-- 404 Illustration -->
      <div class="relative w-32 h-32 mx-auto mb-6 group">
        <div class="absolute inset-0 bg-sky-400 rounded-full animate-ping opacity-20"></div>
        <div class="relative w-32 h-32 bg-gradient-to-tr from-sky-500 to-cyan-400 rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(14,165,233,0.3)] group-hover:scale-105 transition-transform duration-500">
          <span class="text-5xl font-black text-white drop-shadow-md tracking-tighter">404</span>
        </div>
      </div>
      
      <!-- Heading -->
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">ওপস! পেজটি পাওয়া যায়নি</h1>
      
      <!-- Description -->
      <p class="text-slate-600 mb-10 text-lg font-medium leading-relaxed">
        আপনি যে পেজটি খুঁজছেন তা হয়তো ডিলিট হয়ে গেছে অথবা ভুল লিংকে প্রবেশ করেছেন। 
      </p>
      
      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button onclick="window.history.back()" class="w-full sm:w-auto px-6 py-3.5 bg-white border-2 border-slate-200 text-slate-700 rounded-xl font-bold text-base hover:border-sky-500 hover:text-sky-600 transition-all flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          আগের পেজে যান
        </button>
        <a href="/" class="w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-sky-500 to-sky-600 text-white rounded-xl font-bold text-base shadow-[0_8px_20px_rgba(14,165,233,0.3)] hover:shadow-[0_12px_25px_rgba(14,165,233,0.4)] hover:-translate-y-1 transition-all flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          হোমপেজ
        </a>
      </div>
      
    </div>
  </div>
</Layout>
