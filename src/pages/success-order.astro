---
import Layout from '../layouts/Layout.astro';
const orderId = Astro.url.searchParams.get('orderId') || '12345';
---

<Layout title="Thank You | Order Placed">
  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 text-center border border-slate-100">
      <div class="w-20 h-20 bg-green-100 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold text-slate-800 mb-2">THANK YOU</h1>
      <h2 class="text-xl font-bold text-slate-700 mb-4">YOUR ORDER IS PLACED</h2>
      <p class="text-slate-600 mb-6 font-medium">
        We received your order and will begin processing it soon. Your order information appears below.
      </p>
      <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
        <p class="text-slate-700 font-semibold">Your order Number</p>
        <p class="text-2xl font-bold text-blue-600 mt-1">#{orderId}</p>
      </div>
      <a href="/" class="mt-8 inline-block w-full py-3 bg-slate-900 text-white rounded-xl font-semibold hover:bg-slate-800 transition">
        ড্যাশবোর্ডে ফিরে যান
      </a>
    </div>
  </div>
</Layout>
